# Postgres connection string
DATABASE_URL=postgres://pw:change-me@localhost:5432/pw

# Public base URL of the site, used in emails
APP_URL=http://localhost:3000

# Claude API key (processing and the AI Analyst). Without it, items are collected
# but wait unprocessed in the review queue.
ANTHROPIC_API_KEY=
# Model used for per-item extraction (override to trade cost against quality)
PW_EXTRACTION_MODEL=claude-opus-5-5

# Outgoing email. Format: smtp://user:pass@host:587 . Leave empty in development:
# emails are printed to the server log instead.
SMTP_URL=
MAIL_FROM="Pacific Watchmen <no-reply@example.org>"

# Guardian Open Platform key (optional source)
GUARDIAN_API_KEY=

# Minutes between collector runs
COLLECT_INTERVAL_MINUTES=15

# --- Production (docker compose) only ---
# Domain the site is served on; Caddy gets an HTTPS certificate for it
SITE_DOMAIN=pacificwatchmen.example
POSTGRES_PASSWORD=change-me
